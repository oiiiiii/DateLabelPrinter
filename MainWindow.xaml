<Window x:Class="DateLabelPrinter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System"
        xmlns:local="clr-namespace:DateLabelPrinter"
        mc:Ignorable="d"
        Title="日期贴打印工具"
        FontSize="14"
        Height="800"
        Width="1110"
        MinHeight="600"
        MinWidth="900">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="560"/>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 左侧：打印配置和内容编辑区 -->
        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
            <!-- 1. 参数配置区 -->
            <GroupBox Header="打印配置 (默认日期格式20260101)" Margin="0,0,0,10" FontSize="16">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 开启时间 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="开启时间：" VerticalAlignment="Center" Margin="0,10,5,10"/>
                    <TextBox x:Name="StartDateTextBox" Grid.Row="0" Grid.Column="1" Width="160" Text="{Binding StartTime, StringFormat='yyyy.MM.dd'}" TextChanged="DateTextBox_TextChanged" Tag="date" Margin="0,10,15,10" FontSize="16"/>
                    <TextBox x:Name="StartTimeTextBox" Grid.Row="0" Grid.Column="2" Width="110" Text="{Binding StartTime, StringFormat='HH:mm'}" TextChanged="TimeTextBox_TextChanged" Tag="time" Margin="0,10,0,10" FontSize="16"/>

                    <!-- 有效期（2行3列布局） -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="有效期：" VerticalAlignment="Center" Margin="0,10,5,10"/>
                    <Grid x:Name="ValidityRadioGroup" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Row="0" Grid.Column="0" Content="1天" Tag="OneDay" Margin="0,0,15,5" FontSize="16"/>
                        <RadioButton Grid.Row="0" Grid.Column="1" Content="3天" Tag="ThreeDays" Margin="0,0,15,5" FontSize="16"/>
                        <RadioButton Grid.Row="0" Grid.Column="2" Content="7天" Tag="SevenDays" Margin="0,0,0,5" FontSize="16"/>
                        <RadioButton Grid.Row="1" Grid.Column="0" Content="30天" Tag="ThirtyDays" Margin="0,0,15,0" FontSize="16"/>
                        <RadioButton Grid.Row="1" Grid.Column="1" Content="90天" Tag="NinetyDays" Margin="0,0,15,0" FontSize="16"/>
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="CustomRadioButton" Content="自定义" Tag="Custom" FontSize="16"/>
                            <TextBox x:Name="CustomDaysTextBox" Width="55" Height="24" Margin="8,0,0,0" FontSize="14" VerticalContentAlignment="Center" VerticalAlignment="Center"
                                     ToolTip="自定义天数：输入后按回车或移开焦点自动计算过期时间"
                                     TextChanged="CustomDaysTextBox_TextChanged" LostFocus="CustomDaysTextBox_Commit" KeyDown="CustomDaysTextBox_KeyDown"/>
                            <TextBlock Text="天" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <!-- 过期时间 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="过期时间：" VerticalAlignment="Center" Margin="0,10,5,10"/>
                    <TextBox x:Name="ExpireDateTextBox" Grid.Row="2" Grid.Column="1" Width="160" Text="{Binding ExpireTime, StringFormat='yyyy.MM.dd'}" TextChanged="DateTextBox_TextChanged" Tag="date" Margin="0,10,15,10" FontSize="16"/>
                    <TextBox x:Name="ExpireTimeTextBox" Grid.Row="2" Grid.Column="2" Width="110" Text="{Binding ExpireTime, StringFormat='HH:mm'}" TextChanged="TimeTextBox_TextChanged" Tag="time" Margin="0,10,0,10" FontSize="16"/>

                    <!-- 开启人和份数 -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="人员设置：" VerticalAlignment="Center" Margin="0,10,10,10" Cursor="Hand" Foreground="#0066CC" TextDecorations="Underline" ToolTip="点击管理开启人名单" MouseDown="OperatorSettings_Click"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,10" HorizontalAlignment="Left">
                        <TextBlock Text="开启人：" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                        <ComboBox Width="120" ItemsSource="{Binding OperatorList}" Text="{Binding Operator, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" Margin="0,0,15,0" FontSize="14"/>
                        <TextBlock Text="份数：" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                        <TextBox x:Name="CopyCountTextBox" Width="60" Text="{Binding CopyCount}" Margin="0,0,0,0" FontSize="14" TextChanged="CopyCountTextBox_TextChanged"/>
                    </StackPanel>

                    <!-- 字体、字号和行间距 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="字体设置：" VerticalAlignment="Center" Margin="0,10,10,10"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,10" HorizontalAlignment="Left">
                        <TextBlock Text="字体：" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                        <ComboBox Width="100" SelectedValue="{Binding FontFamily}" Margin="0,0,15,0" FontSize="16">
                            <sys:String>黑体</sys:String>
                            <sys:String>宋体</sys:String>
                            <sys:String>楷体</sys:String>
                            <sys:String>Arial</sys:String>
                            <sys:String>Microsoft YaHei</sys:String>
                        </ComboBox>
                        <TextBlock Text="字号：" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                        <ComboBox Width="60" SelectedValue="{Binding FontSize}" Margin="0,0,15,0" FontSize="16">
                            <sys:Int32>10</sys:Int32>
                            <sys:Int32>12</sys:Int32>
                            <sys:Int32>14</sys:Int32>
                            <sys:Int32>16</sys:Int32>
                            <sys:Int32>18</sys:Int32>
                            <sys:Int32>20</sys:Int32>
                            <sys:Int32>22</sys:Int32>
                            <sys:Int32>24</sys:Int32>
                            <sys:Int32>26</sys:Int32>
                            <sys:Int32>28</sys:Int32>
                            <sys:Int32>30</sys:Int32>
                        </ComboBox>
                        <TextBlock Text="行间距：" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                        <ComboBox Width="80" SelectedValue="{Binding LineSpacing}" Margin="0,0,0,0" FontSize="16">
                            <sys:Double>1.0</sys:Double>
                            <sys:Double>1.2</sys:Double>
                            <sys:Double>1.5</sys:Double>
                            <sys:Double>1.8</sys:Double>
                            <sys:Double>2.0</sys:Double>
                            <sys:Double>2.5</sys:Double>
                            <sys:Double>3.0</sys:Double>
                        </ComboBox>
                    </StackPanel>

                    <!-- 页边距 -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="页边距：" VerticalAlignment="Center" Margin="0,10,10,10"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,10" HorizontalAlignment="Left">
                        <TextBlock Text="左：" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                        <TextBox Width="50" Text="{Binding MarginLeft}" Margin="0,0,15,0" FontSize="14" Tag="margin"/>
                        <TextBlock Text="上：" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                        <TextBox Width="50" Text="{Binding MarginTop}" Margin="0,0,15,0" FontSize="14" Tag="margin"/>
                        <TextBlock Text="右：" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                        <TextBox Width="50" Text="{Binding MarginRight}" Margin="0,0,15,0" FontSize="14" Tag="margin"/>
                        <TextBlock Text="下：" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                        <TextBox Width="50" Text="{Binding MarginBottom}" Margin="0,0,0,0" FontSize="14" Tag="margin"/>
                    </StackPanel>

                    <!-- 打印机 -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="打印机：" VerticalAlignment="Center" Margin="0,10,5,10"/>
                    <ComboBox x:Name="PrinterComboBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="7" Width="350" SelectedValue="{Binding PrinterName}" Margin="0,10,0,10" FontSize="16"/>
                </Grid>
            </GroupBox>

            <!-- 2. 内容编辑区 -->
            <GroupBox Header="打印内容模板" Margin="0,0,0,10" FontSize="16">
                <TextBox Text="{Binding PrintContentTemplate}" AcceptsReturn="True" Height="180" FontSize="16" Margin="5"/>
            </GroupBox>

            <!-- 3. 操作区 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                <Button Content="预览" Width="180" Height="50" Click="PreviewButton_Click" FontSize="18" Margin="0,0,10,0"/>
                <Button x:Name="PrintButton" Content="打印" Width="180" Height="50" Click="PrintButton_Click" FontSize="18"/>
            </StackPanel>
            <!-- 状态显示区 -->
            <TextBlock x:Name="StatusTextBlock" HorizontalAlignment="Center" FontSize="16" Margin="0,0,0,20" TextWrapping="Wrap" TextAlignment="Center" Foreground="Green"/>
        </StackPanel>

        <!-- 右侧：预览区 -->
        <GroupBox Grid.Column="1" Grid.Row="0" Header="打印预览（56mm*50mm）">
            <DocumentViewer x:Name="PreviewDocumentViewer" 
                           HorizontalAlignment="Stretch" 
                           VerticalAlignment="Stretch" 
                           Margin="10"/> <!-- 留出5%左右的边距 -->
        </GroupBox>


    </Grid>
</Window>